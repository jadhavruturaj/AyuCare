# ========================================================
# आयुCare (AyuCare) - Environment Variables Configuration
# Copy this file to .env and configure your local settings.
# ========================================================

# Flask Application Secret Key
SECRET_KEY=ayucare-super-secret-key-change-in-prod-2026

# Database Type: 'mysql' for production/MySQL Workbench or 'sqlite' for zero-config offline mode
DB_TYPE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ayucare_db

# Server Settings
PORT=5001
FLASK_DEBUG=True

# CORS & Token Settings
CORS_ORIGINS=*
TOKEN_EXPIRATION_HOURS=24
OTP_EXPIRATION_MINUTES=10
PASSWORD_RESET_EXPIRATION_HOURS=1

# Frontend Base URL (for email links)
FRONTEND_BASE_URL=http://localhost:5001

# ========================================================
# Email Delivery Service (SMTP)
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password.
# For SendGrid: Use smtp.sendgrid.net, port 587, user 'apikey', password <API_KEY>.
# ========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ayucare.health
SMTP_FROM_NAME=आयुCare (AyuCare)
SMTP_USE_TLS=True

# ========================================================
# SMS Gateway Settings (Mobile OTP Verification)
# Supported: 'console' (logs OTP to server console for testing), 'twilio', or 'fast2sms'
# ========================================================
SMS_GATEWAY=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
