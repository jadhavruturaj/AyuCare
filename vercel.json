{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "public/**,frontend/**,database/**"
    },
    "app.py": {
      "includeFiles": "public/**,frontend/**,database/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
